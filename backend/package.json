    "migrate:undo": "node dist/scripts/migrate.js down",
    "migrate:undo:all": "node dist/scripts/migrate.js down:all",
    "migrate:status": "node dist/scripts/migrate.js status",
    "seed": "node dist/scripts/migrate.js seed",
    "seed:demo": "node dist/scripts/seed-controlled-dataset.js",
    "seed:controlled": "node dist/scripts/seed-controlled-dataset.js",
    "seed:undo": "node dist/scripts/migrate.js seed:undo",
    "seed:undo:all": "node dist/scripts/migrate.js seed:undo:all"
