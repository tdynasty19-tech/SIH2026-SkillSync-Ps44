    "test:notifications-audit": "node dist/scripts/test-notifications-audit.js",
    "test:matching-recommendation": "node dist/scripts/test-matching-recommendation.js",
    "test:analytics": "node dist/scripts/test-analytics.js",
    "test:affiliation": "node dist/scripts/test-student-affiliation.js",
    "test:phase-a-security": "node dist/scripts/test-phase-a-security.js",
    "test:academic-program": "node dist/scripts/test-academic-program.js",
    "test:batch-enrollment": "node dist/scripts/test-batch-enrollment.js",
    "test:ai": "node dist/scripts/test-ai.js",
    "test:phase3d": "node dist/scripts/test-phase3d.js",
    "test:phase3e": "node dist/scripts/test-phase3e.js",
    "test:phase4": "node dist/scripts/test-phase4-e2e.js",
    "test:search": "node dist/scripts/test-search.js",
    "test:security": "node dist/scripts/test-security.js",
    "test:integration": "node dist/scripts/test-integration.js",
    "test:demo": "node dist/scripts/test-demo-seed.js",
    "test:performance": "node dist/scripts/test-performance-production.js",
