{
  "name": "sih-ps44-backend",
  "version": "1.0.0",
  "description": "SIH PS 44 - Academia-Industry Collaboration & Skill Intelligence Platform Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch dist/server.js",
    "build": "rimraf dist && tsc",
