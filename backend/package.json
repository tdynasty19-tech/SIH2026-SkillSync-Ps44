    "test:auth": "node dist/scripts/test-auth.js",
    "test:student": "node dist/scripts/test-student.js",
    "test:skill-assessment": "node dist/scripts/test-skill-assessment.js",
    "test:opportunity": "node dist/scripts/test-opportunity.js",
    "test:application": "node dist/scripts/test-application.js",
    "test:industry": "node dist/scripts/test-industry.js",
    "test:academician": "node dist/scripts/test-academician.js",
    "test:institution-collaboration": "node dist/scripts/test-institution-collaboration.js",
